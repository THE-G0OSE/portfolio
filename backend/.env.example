PORT=4000

# postgres from docker-compose.yml (host port 5434)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public"

# random long string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

ADMIN_LOGIN="admin"
# bcrypt hash of the admin password: yarn admin:hash <password>
ADMIN_PASSWORD_HASH=''

# Next.js route that drops the cached portfolio after edits, secret must match the site's .env.local
SITE_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET=""
